NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

OPENAI_API_KEY="your-openai-api-key"

STRIPE_SECRET_KEY="your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"
STRIPE_PRICE_ID_PRO="price_id_for_pro_plan"

# Rate Limiting (Upstash Redis) - Optionnel
# Créer un compte gratuit sur https://upstash.com
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Worker document (chunking PDF) — requis en prod pour que le chunking tourne sans ton PC
# Voir docs/DEPLOY-WORKER-DOCUMENTS.md (Railway / Fly.io / Render)
# GCP_PROJECT_ID="your-gcp-project"
# GCS_BUCKET="nothly-storage"
# GCP_STORAGE_BUCKET="nothly-storage"  # alias, priorité à GCS_BUCKET

# Authentification GCS — préférer GOOGLE_APPLICATION_CREDENTIALS (évite ERR_OSSL_UNSUPPORTED)
# Local: chemin absolu vers le fichier JSON du service account
# GOOGLE_APPLICATION_CREDENTIALS="/chemin/absolu/vers/key.json"

# Vercel / pas de fichier: GCP_SERVICE_ACCOUNT_KEY (JSON une ligne) → écrit en /tmp au runtime
# GCP_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...",...}'

# Si erreur OpenSSL "1E08010C:DECODER routines::unsupported" en local: npm run dev:legacy
# JOB_POLL_INTERVAL_MS=2000
